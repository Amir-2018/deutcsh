<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Deutschland QCM - Test</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="student-page">
    <%- include('partials/header') %>
    <main>
        <section class="view active">
            <h2><i class="fa-solid fa-user-graduate"></i> Espace Élève</h2>

            <% if (!test) { %>
            <div class="card">
                <h3><i class="fa-solid fa-triangle-exclamation"></i> Aucun test trouvé</h3>
                <p><%= error || 'Veuillez scanner le QR Code partagé par votre professeur.' %></p>
                <a href="/" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Retour à l'espace professeur</a>
            </div>
            <% } else { %>

            <!-- Étape 1 : saisie du nom -->
            <div class="card" id="name-step">
                <h3><i class="fa-solid fa-hand-sparkles"></i> Bienvenue !</h3>
                <p>Veuillez saisir votre nom pour commencer le test.</p>
                <div class="form-group">
                    <label for="name-input">Votre nom :</label>
                    <input type="text" id="name-input" placeholder="Prénom et nom...">
                </div>
                <button type="button" id="start-btn" class="btn btn-primary">
                    <i class="fa-solid fa-play"></i> Commencer le test
                </button>
            </div>

            <!-- Étape 2 : questions -->
            <div class="card hidden" id="test-step">
                <h3>🇩🇪 Test Deutschland</h3>
                <p class="test-info">Répondez à toutes les questions puis cliquez sur « Soumettre le test ».</p>
                <form action="/test/<%= test.id %>/submit" method="POST" id="test-form">
                    <input type="hidden" name="name" id="name-hidden">
                    <div id="test-questions">
                        <% test.questions.forEach((q, i) => { %>
                        <div class="test-question" data-q="<%= i %>">
                            <div class="question-label">Question <%= i + 1 %> : <%= q.text %></div>
                            <% q.options.forEach((opt, j) => { %>
                            <label class="test-option">
                                <input type="radio" name="answers[<%= i %>]" value="<%= j %>">
                                <span class="option-text"><%= opt %></span>
                            </label>
                            <% }) %>
                        </div>
                        <% }) %>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-circle-check"></i> Soumettre le test</button>
                </form>
            </div>
            <% } %>
        </section>
    </main>
    <%- include('partials/footer') %>
    <script>
        window.TEST_ID = '<%= test ? test.id : "" %>';
        window.TOTAL_QUESTIONS = <%= test ? test.questions.length : 0 %>;
    </script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/student.js"></script>
</body>
</html>
